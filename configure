#!/bin/sh
# Detect IPOPT with pkg-config. Without it optcompR builds without the
# IPOPT backend. Set OPTCOMPR_NO_IPOPT=1 to skip detection.
PKG_CPPFLAGS=""
PKG_LIBS=""
if [ -z "$OPTCOMPR_NO_IPOPT" ] && command -v pkg-config >/dev/null 2>&1 &&
   pkg-config --exists ipopt; then
  PKG_CPPFLAGS="-DHAVE_IPOPT `pkg-config --cflags ipopt`"
  if pkg-config --atleast-version=3.14 ipopt; then
    PKG_CPPFLAGS="-DHAVE_IPOPT_314 $PKG_CPPFLAGS"
  fi
  PKG_LIBS="`pkg-config --libs ipopt`"
  echo "optcompR: building with IPOPT `pkg-config --modversion ipopt`"
else
  echo "optcompR: IPOPT not found by pkg-config; building without it"
fi
# escape the characters that are special in a sed replacement
esc() { printf '%s\n' "$1" | sed -e 's/[\\&|]/\\&/g'; }
sed -e "s|@PKG_CPPFLAGS@|$(esc "$PKG_CPPFLAGS")|" \
  -e "s|@PKG_LIBS@|$(esc "$PKG_LIBS")|" src/Makevars.in > src/Makevars
